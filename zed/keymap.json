[
  {
    "context": "Dock || Editor",
    "bindings": {
      "ctrl-\\": "terminal_panel::Toggle",
    },
  },
  // vim
  {
    "context": "!AgentPanel && vim_mode == insert",
    "bindings": {
      // put key-bindings here if you want them to work in insert mode
      // e.g.
      "j k": "vim::NormalBefore",
    },
  },

  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      // Traditional Vim behavior
      // "q": "vim::AnyQuotes",
      // "b": "vim::AnyBrackets",
      // mini.ai plugin behavior
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets",
    },
  },
  {
    "context": "Dock || (Editor && vim_mode == normal)",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "os==windows > (Editor && !menu)",
    "bindings": {
      "ctrl-c": "editor::Copy", // vim default: return to normal mode
      "ctrl-x": "editor::Cut", // vim default: decrement
      "ctrl-v": "editor::Paste", // vim default: visual block mode
      "ctrl-a": "editor::SelectAll", // vim default: increment
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-x": "vim::Exchange",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space c f": "editor::Format",
      "space c r": "editor::Rename",
      "space c a": "editor::ToggleCodeActions",
      "space e": "workspace::ToggleLeftDock",
      "space b p": "pane::TogglePinTab",
      "space b d": "pane::CloseActiveItem",
      "space space": "file_finder::Toggle",
      "space g b": "editor::ToggleGitBlameInline",
      "space g c": "git::Blame",
      "space d i": "editor::ToggleInlineDiagnostics",
      "space o": "outline::Toggle",
      "space l": "workspace::ToggleRightDock",
      // "space s": "text_finder::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-w": null,
    },
  },
  // netrw
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "q": "workspace::ToggleLeftDock",
      "r": "project_panel::Rename",
      "a": "project_panel::NewFile",
      "d": "project_panel::Delete",
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "enter": "picker::ConfirmCompletion",
    },
  },
  {
    "context": "Picker > Editor",
    "unbind": {
      "tab": "picker::ConfirmCompletion",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-p": "file_finder::Toggle"
    }
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor",
    "unbind": {
      "ctrl-p": "file_finder::Toggle"
    }
  }
]

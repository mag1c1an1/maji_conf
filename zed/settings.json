{
    "base_keymap": "VSCode",
    "wsl_connections": [
        {
            "distro_name": "Arch",
            "user": null,
            "projects": [
                {
                    "paths": ["/home/maji/Projects"]
                }
            ]
        },
        {
            "distro_name": "NixOS",
            "user": null,
            "projects": [
                {
                    "paths": ["/home/mag1cian/Projects/maji_conf"]
                }
            ]
        }
    ],
    "ssh_connections": [
        {
            "host": "aws",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/jiax/Projects/LakeSoul"]
                }
            ]
        }
    ],
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    },
    "minimap": {
        "show": "always"
    },
    "vim_mode": true,
    "icon_theme": "Zed (Default)",
    "ui_font_size": 16,
    "buffer_font_size": 14.0,
    "buffer_font_family": "Lilex Nerd Font",
    "terminal": {
        "font_size": 14.0,
        "cursor_shape": "bar",
        "blinking": "on",
        "font_family": "FantasqueSansM Nerd Font",
        "line_height": {
            "custom": 1.1
        }
    },
    "theme": {
        "mode": "light",
        "light": "One Light",
        "dark": "One Dark"
    },
    "languages": {
        "Python": {
            "language_servers": ["ruff", "..."]
        },
        "Nix": {
            "language_servers": ["nixd", "!nil"]
        }
    },
    "lsp": {
        "nixd": {
            "initialization_options": {
                "formatting": {
                    "command": ["alejandra", "--quiet", "--"] // or ["nixfmt"]
                }
            }
        }
    }
}

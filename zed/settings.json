  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "minimap": {
    "show": "always",
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "ui_font_size": 24,
  "buffer_font_size": 20.0,
  "buffer_font_family": "0xProto Nerd Font",
  "terminal": {
    "font_size": 18.0,
    "cursor_shape": "bar",
    "blinking": "on",
    "font_family": "0xProto Nerd Font",
    "line_height": {
      "custom": 1.1,
    },
  },
  "theme": {
    "mode": "light",
    "light": "Claude Light",
    "dark": "Fleet Dark",
  },
  "theme_overrides": {
    "Fleet Light": {
      "syntax": {
        "hint": {
          "color": "#ff0000a0",
          "font_style": "italic",
        },
      },
    },
    "Fleet Dark": {
      "syntax": {
        "hint": {
          "color": "#7d7f82",
          "font_style": "italic",
        },
      },
    },
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "editor": {
          "tabSize": 1,
        },
      },
    },
  },
  "languages": {
    "YAML": {
      "formatter": "language_server",
    },
    "Python": {
      "language_servers": ["ruff", "ty", "!basedpyright", "!pylsp", "!pyright"],
    },
    "Nix": {
      "language_servers": ["nixd", "!nil", "!nixfmt", "..."],
      "formatter": {
        "external": {
          "command": "alejandra", // or "nixfmt"
          "arguments": ["--quiet", "--"],
        },
      },
    },
    "Java": {
      "enable_language_server": false,
    },
    "Go": {
      "enable_language_server": false,
    },
  },
  "proxy": "http://127.0.0.1:10801",
}
